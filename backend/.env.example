PROJECT_NAME="Rolly F&B AI Training Platform"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-strong-random-secret-key-for-jwt"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:your-db-password@db.your-supabase-id.supabase.co:5432/postgres"

# Redis Cache & Celery Broker
REDIS_URL="redis://localhost:6379/0"

# AI Provider (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_ROLEPLAY_MODEL="gemini-1.5-flash"
GEMINI_SCORING_MODEL="gemini-1.5-flash"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "https://rolly.vn"]
